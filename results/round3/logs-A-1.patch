+const fmt = (level, msg, err) =>
+  `${new Date().toISOString()} ${level} ${msg}${err ? `\n${err.stack ?? err}` : ''}`;
+
+export const logger = {
+  info: (msg) => console.log(fmt('INFO', msg)),
+  error: (msg, err) => console.error(fmt('ERROR', msg, err)),
+};
