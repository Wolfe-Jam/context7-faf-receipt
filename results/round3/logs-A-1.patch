+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import express from 'express';
+import { logger } from '../src/logger.js';
+import { requestLogger, errorHandler } from '../src/app.js';
+
+test('requests are logged and unhandled async errors are logged with 500', async (t) => {
+  const infos = [];
+  const errors = [];
+  t.mock.method(logger, 'info', (m) => infos.push(m));
+  t.mock.method(logger, 'error', (m, err) => errors.push({ m, err }));
+
+  const app = express();
+  app.use(requestLogger);
+  app.get('/boom', async () => {
+    throw new Error('boom');
+  });
+  app.use(errorHandler);
+
+  const server = app.listen(0);
+  const r = await fetch(`http://127.0.0.1:${server.address().port}/boom`);
+  server.close();
+
+  assert.equal(r.status, 500);
+  assert.equal(errors.length, 1);
+  assert.equal(errors[0].err.message, 'boom');
+  assert.match(infos[0], /^GET \/boom 500 /);
+});
