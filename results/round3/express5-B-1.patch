+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, writeFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import http from 'node:http';
+import { createApp } from '../src/app.js';
+
+let dir, server, url;
+
+before(async () => {
+  dir = await mkdtemp(path.join(tmpdir(), 'files-api-'));
+  await mkdir(path.join(dir, 'docs', 'guide'), { recursive: true });
+  await writeFile(path.join(dir, 'docs', 'guide', 'intro.md'), 'hello');
+  await writeFile(path.join(dir, 'top.txt'), 'abc');
+  server = createApp({ root: dir }).listen(0);
+  url = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(async () => {
+  server.close();
+  await rm(dir, { recursive: true, force: true });
+});
+
+test('metadata for nested file path', async () => {
+  const r = await fetch(`${url}/files/docs/guide/intro.md`);
+  assert.equal(r.status, 200);
+  const body = await r.json();
+  assert.equal(body.path, 'docs/guide/intro.md');
+  assert.equal(body.name, 'intro.md');
+  assert.equal(body.type, 'file');
+  assert.equal(body.size, 5);
+  assert.ok(!Number.isNaN(Date.parse(body.modified)));
+});
+
+test('metadata for top-level file and directory', async () => {
+  const f = await (await fetch(`${url}/files/top.txt`)).json();
+  assert.equal(f.size, 3);
+  const d = await (await fetch(`${url}/files/docs/guide`)).json();
+  assert.equal(d.type, 'directory');
+});
+
+test('missing file gives JSON 404', async () => {
+  const r = await fetch(`${url}/files/nope/missing.txt`);
+  assert.equal(r.status, 404);
+  assert.match(r.headers.get('content-type'), /json/);
+  assert.deepEqual(await r.json(), { error: 'Not Found' });
+});
+
+test('path traversal is rejected', async () => {
+  // fetch() normalizes dot segments client-side, so send the raw path.
+  const res = await new Promise((resolve, reject) => {
+    http
+      .get({ host: '127.0.0.1', port: server.address().port, path: '/files/%2e%2e/%2e%2e/etc/passwd' }, resolve)
+      .on('error', reject);
+  });
+  res.resume();
+  assert.equal(res.statusCode, 400);
+  assert.match(res.headers['content-type'], /json/);
+});
+
+test('unknown routes give JSON 404', async () => {
+  for (const [method, p] of [['GET', '/nope'], ['POST', '/health'], ['GET', '/files']]) {
+    const r = await fetch(`${url}${p}`, { method });
+    assert.equal(r.status, 404);
+    assert.match(r.headers.get('content-type'), /json/);
+    assert.deepEqual(await r.json(), { error: 'Not Found' });
+  }
+});
