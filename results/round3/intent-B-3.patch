+import pytest
+from fastapi.testclient import TestClient
+from sqlmodel import Session, SQLModel, create_engine
+from sqlmodel.pool import StaticPool
+
+from app.db import get_session
+from app.main import app
+
+
+@pytest.fixture
+def client():
+    engine = create_engine(
+        "sqlite://",
+        connect_args={"check_same_thread": False},
+        poolclass=StaticPool,
+    )
+    SQLModel.metadata.create_all(engine)
+
+    def override():
+        with Session(engine) as session:
+            yield session
+
+    app.dependency_overrides[get_session] = override
+    with TestClient(app) as c:
+        yield c
+    app.dependency_overrides.clear()
+
+
+def make_item(client, name, price):
+    return client.post("/items", json={"name": name, "price_cents": price}).json()["id"]
+
+
+def order_body(lines, email="a@example.com"):
+    return {"customer_email": email, "lines": lines}
+
+
+def test_create_order_computes_total(client):
+    pen = make_item(client, "pen", 150)
+    pad = make_item(client, "pad", 400)
+    r = client.post(
+        "/orders",
+        json=order_body(
+            [{"item_id": pen, "quantity": 3}, {"item_id": pad, "quantity": 1}]
+        ),
+    )
+    assert r.status_code == 201
+    body = r.json()
+    assert body["total_cents"] == 850
+    assert len(body["lines"]) == 2
+    assert body["lines"][0]["unit_price_cents"] == 150
+
+
+def test_get_order(client):
+    pen = make_item(client, "pen", 150)
+    oid = client.post(
+        "/orders", json=order_body([{"item_id": pen, "quantity": 2}])
+    ).json()["id"]
+    r = client.get(f"/orders/{oid}")
+    assert r.status_code == 200
+    assert r.json()["total_cents"] == 300
+    assert r.json()["customer_email"] == "a@example.com"
+
+
+def test_get_missing_order(client):
+    assert client.get("/orders/999").status_code == 404
+
+
+def test_unknown_item_404(client):
+    r = client.post("/orders", json=order_body([{"item_id": 42, "quantity": 1}]))
+    assert r.status_code == 404
+
+
+def test_invalid_quantity_and_empty_lines(client):
+    pen = make_item(client, "pen", 150)
+    r = client.post("/orders", json=order_body([{"item_id": pen, "quantity": 0}]))
+    assert r.status_code == 422
+    assert client.post("/orders", json=order_body([])).status_code == 422
+
+
+def test_invalid_email(client):
+    pen = make_item(client, "pen", 150)
+    r = client.post(
+        "/orders", json=order_body([{"item_id": pen, "quantity": 1}], email="nope")
+    )
+    assert r.status_code == 422
