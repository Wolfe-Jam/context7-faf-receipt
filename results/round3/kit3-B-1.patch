@@ -1,12 +1,40 @@
 <script lang="ts">
+  import { goto } from '$app/navigation';
   import { formatMinutes } from '#lib/recipes.js';
 
   let { data } = $props();
+
+  // Local input state, seeded from the URL (re-synced on back/forward navigation).
+  let term = $state('');
+  $effect(() => {
+    term = data.q;
+  });
+
+  function onInput() {
+    const value = term.trim();
+    goto(value ? `?q=${encodeURIComponent(value)}` : '?', {
+      replace: true,
+      reset: false
+    });
+  }
 </script>
 
 <h1>Recipe box</h1>
-<ul>
-  {#each data.recipes as recipe (recipe.id)}
-    <li>{recipe.title} · {formatMinutes(recipe.minutes)}</li>
-  {/each}
-</ul>
+
+<!-- Plain GET form, so search also works without JavaScript -->
+<form method="GET" role="search">
+  <label>
+    Search recipes
+    <input type="search" name="q" bind:value={term} oninput={onInput} />
+  </label>
+</form>
+
+{#if data.recipes.length}
+  <ul>
+    {#each data.recipes as recipe (recipe.id)}
+      <li>{recipe.title} · {formatMinutes(recipe.minutes)}</li>
+    {/each}
+  </ul>
+{:else}
+  <p>No recipes match “{data.q}”.</p>
+{/if}
