@@ -1,8 +1,54 @@
 import express from 'express';
+import path from 'node:path';
+import { stat } from 'node:fs/promises';
 
+export const FILES_ROOT = path.resolve(process.env.FILES_ROOT ?? 'files');
+
 export const app = express();
 app.use(express.json());
 
 app.get('/health', (req, res) => {
   res.json({ ok: true });
+});
+
+// Express 5 / path-to-regexp 8: a named wildcard yields an array of segments.
+app.get('/files/*path', async (req, res) => {
+  const rel = req.params.path.join('/');
+  const full = path.resolve(FILES_ROOT, rel);
+
+  // Reject traversal outside the root (and NUL bytes).
+  if (rel.includes('\0') || !full.startsWith(FILES_ROOT + path.sep)) {
+    return res.status(400).json({ error: 'Invalid path' });
+  }
+
+  let s;
+  try {
+    s = await stat(full);
+  } catch (err) {
+    if (err.code === 'ENOENT' || err.code === 'ENOTDIR') {
+      return res.status(404).json({ error: 'Not Found', path: rel });
+    }
+    throw err; // Express 5 forwards async rejections to the error handler
+  }
+
+  res.json({
+    path: rel,
+    name: path.basename(full),
+    type: s.isDirectory() ? 'directory' : 'file',
+    size: s.size,
+    modified: s.mtime.toISOString(),
+    created: s.birthtime.toISOString(),
+  });
+});
+
+// JSON 404 for every unknown route
+app.use((req, res) => {
+  res.status(404).json({ error: 'Not Found' });
+});
+
+// JSON error handler
+app.use((err, req, res, next) => {
+  if (res.headersSent) return next(err);
+  const status = err.status ?? err.statusCode ?? 500;
+  res.status(status).json({ error: status === 500 ? 'Internal Server Error' : err.message });
 });
