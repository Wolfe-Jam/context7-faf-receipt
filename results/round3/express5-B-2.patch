+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, writeFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import http from 'node:http';
+
+let dir;
+let server;
+let base;
+
+before(async () => {
+  dir = await mkdtemp(path.join(tmpdir(), 'files-api-'));
+  process.env.FILES_ROOT = dir;
+  await mkdir(path.join(dir, 'docs/guide'), { recursive: true });
+  await writeFile(path.join(dir, 'readme.txt'), 'hello');
+  await writeFile(path.join(dir, 'docs/guide/intro.md'), '# Intro');
+  // Import after FILES_ROOT is set (it is read at module load).
+  const mod = await import('../src/app.js');
+  server = mod.app.listen(0);
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(async () => {
+  server.close();
+  await rm(dir, { recursive: true, force: true });
+});
+
+test('metadata for top-level file', async () => {
+  const r = await fetch(`${base}/files/readme.txt`);
+  assert.equal(r.status, 200);
+  const j = await r.json();
+  assert.equal(j.name, 'readme.txt');
+  assert.equal(j.type, 'file');
+  assert.equal(j.size, 5);
+  assert.ok(!Number.isNaN(Date.parse(j.modified)));
+});
+
+test('metadata for nested path with slashes', async () => {
+  const r = await fetch(`${base}/files/docs/guide/intro.md`);
+  assert.equal(r.status, 200);
+  const j = await r.json();
+  assert.equal(j.path, 'docs/guide/intro.md');
+  assert.equal(j.size, 7);
+});
+
+test('directory reports type directory', async () => {
+  const j = await (await fetch(`${base}/files/docs`)).json();
+  assert.equal(j.type, 'directory');
+});
+
+test('missing file gives JSON 404', async () => {
+  const r = await fetch(`${base}/files/nope/missing.txt`);
+  assert.equal(r.status, 404);
+  assert.match(r.headers.get('content-type'), /json/);
+  assert.equal((await r.json()).error, 'Not Found');
+});
+
+test('path traversal is rejected', async () => {
+  // fetch() normalizes dot segments client-side, so use raw http.
+  const { status, type } = await new Promise((resolve, reject) => {
+    http
+      .get({ host: '127.0.0.1', port: server.address().port, path: '/files/%2e%2e/%2e%2e/etc/passwd' }, (res) => {
+        res.resume();
+        resolve({ status: res.statusCode, type: res.headers['content-type'] });
+      })
+      .on('error', reject);
+  });
+  assert.equal(status, 400);
+  assert.match(type, /json/);
+});
+
+test('unknown route gives JSON 404', async () => {
+  for (const [method, p] of [['GET', '/nothing'], ['POST', '/health'], ['GET', '/files']]) {
+    const r = await fetch(`${base}${p}`, { method });
+    assert.equal(r.status, 404, `${method} ${p}`);
+    assert.match(r.headers.get('content-type'), /json/);
+    assert.deepEqual(await r.json(), { error: 'Not Found' });
+  }
+});
