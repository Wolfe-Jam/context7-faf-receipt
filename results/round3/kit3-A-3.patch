--- <rig>/cases/kit3/A/src/routes/+page.svelte	2026-11-16 20:54:50
+++ <rig>/runs3/kit3-A-3/src/routes/+page.svelte	2026-11-16 21:05:02
@@ -1,12 +1,33 @@
 <script lang="ts">
+  import { goto } from '$app/navigation';
   import { formatMinutes } from '#lib/recipes.js';
 
   let { data } = $props();
+
+  function onInput(e: Event & { currentTarget: HTMLInputElement }) {
+    const q = e.currentTarget.value;
+    const params = new URLSearchParams();
+    if (q) params.set('q', q);
+    const qs = params.toString();
+    goto(qs ? `?${qs}` : '?', { replace: true, reset: false });
+  }
 </script>
 
 <h1>Recipe box</h1>
+<form role="search" method="GET">
+  <input
+    type="search"
+    name="q"
+    placeholder="Search recipes"
+    aria-label="Search recipes by title"
+    value={data.q}
+    oninput={onInput}
+  />
+</form>
 <ul>
   {#each data.recipes as recipe (recipe.id)}
     <li>{recipe.title} · {formatMinutes(recipe.minutes)}</li>
+  {:else}
+    <li>No recipes match.</li>
   {/each}
 </ul>
