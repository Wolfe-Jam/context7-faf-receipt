+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { app } from '../src/app.js';
+
+let server, base;
+before(() => {
+  server = app.listen(0);
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+after(() => server.close());
+
+test('GET /files/<single segment>', async () => {
+  const r = await fetch(`${base}/files/readme.md`);
+  assert.equal(r.status, 200);
+  assert.deepEqual(await r.json(), {
+    path: 'readme.md', name: 'readme.md', directory: '', extension: 'md', depth: 1,
+  });
+});
+
+test('GET /files/<nested path with slashes>', async () => {
+  const r = await fetch(`${base}/files/a/b/c/archive.tar.gz`);
+  assert.equal(r.status, 200);
+  assert.deepEqual(await r.json(), {
+    path: 'a/b/c/archive.tar.gz', name: 'archive.tar.gz', directory: 'a/b/c', extension: 'gz', depth: 4,
+  });
+});
+
+test('file without extension', async () => {
+  const body = await (await fetch(`${base}/files/bin/Makefile`)).json();
+  assert.equal(body.extension, '');
+});
+
+test('GET /files/ with no path is a JSON 404', async () => {
+  const r = await fetch(`${base}/files/`);
+  assert.equal(r.status, 404);
+  assert.match(r.headers.get('content-type'), /application\/json/);
+});
+
+test('unknown route returns JSON 404', async () => {
+  const r = await fetch(`${base}/nope`);
+  assert.equal(r.status, 404);
+  assert.match(r.headers.get('content-type'), /application\/json/);
+  assert.deepEqual(await r.json(), { error: 'Not Found', path: '/nope' });
+});
+
+test('unsupported method on known route returns JSON 404', async () => {
+  const r = await fetch(`${base}/health`, { method: 'POST' });
+  assert.equal(r.status, 404);
+  assert.equal((await r.json()).error, 'Not Found');
+});
+
+test('malformed JSON body yields JSON error, not HTML', async () => {
+  const r = await fetch(`${base}/health`, {
+    method: 'POST', headers: { 'content-type': 'application/json' }, body: '{bad',
+  });
+  assert.equal(r.status, 400);
+  assert.match(r.headers.get('content-type'), /application\/json/);
+});
