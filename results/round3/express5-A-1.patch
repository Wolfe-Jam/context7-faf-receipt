+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { app } from '../src/app.js';
+
+async function get(path) {
+  const server = app.listen(0);
+  try {
+    const { port } = server.address();
+    const r = await fetch(`http://127.0.0.1:${port}${path}`);
+    return { status: r.status, type: r.headers.get('content-type'), body: await r.json() };
+  } finally {
+    server.close();
+  }
+}
+
+test('GET /files/<single segment>', async () => {
+  const r = await get('/files/readme.md');
+  assert.equal(r.status, 200);
+  assert.deepEqual(r.body, { path: 'readme.md', name: 'readme.md', extension: 'md', directory: '', depth: 1 });
+});
+
+test('GET /files/<nested path with slashes>', async () => {
+  const r = await get('/files/a/b/c/archive.tar.gz');
+  assert.equal(r.status, 200);
+  assert.equal(r.body.path, 'a/b/c/archive.tar.gz');
+  assert.equal(r.body.directory, 'a/b/c');
+  assert.equal(r.body.extension, 'gz');
+  assert.equal(r.body.depth, 4);
+});
+
+test('file without extension', async () => {
+  const r = await get('/files/bin/Makefile');
+  assert.equal(r.body.extension, null);
+});
+
+test('GET /files/ with no path is a JSON 404', async () => {
+  const r = await get('/files/');
+  assert.equal(r.status, 404);
+  assert.match(r.type, /application\/json/);
+});
+
+test('unknown route returns JSON 404', async () => {
+  const r = await get('/nope/at/all');
+  assert.equal(r.status, 404);
+  assert.match(r.type, /application\/json/);
+  assert.equal(r.body.error, 'Not Found');
+});
