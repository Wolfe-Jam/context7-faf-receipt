+import pytest
+from fastapi.testclient import TestClient
+from sqlmodel import Session, SQLModel, create_engine
+from sqlmodel.pool import StaticPool
+
+from app.db import get_session
+from app.main import app
+
+
+@pytest.fixture
+def client():
+    engine = create_engine(
+        "sqlite://", connect_args={"check_same_thread": False}, poolclass=StaticPool
+    )
+    SQLModel.metadata.create_all(engine)
+
+    def override():
+        with Session(engine) as session:
+            yield session
+
+    app.dependency_overrides[get_session] = override
+    with TestClient(app) as c:
+        yield c
+    app.dependency_overrides.clear()
+
+
+def make_item(client, name, price):
+    return client.post("/items", json={"name": name, "price_cents": price}).json()["id"]
+
+
+def test_create_order_total(client):
+    pen = make_item(client, "pen", 150)
+    pad = make_item(client, "pad", 400)
+    r = client.post(
+        "/orders",
+        json={
+            "customer_email": "a@example.com",
+            "lines": [
+                {"item_id": pen, "quantity": 3},
+                {"item_id": pad, "quantity": 2},
+            ],
+        },
+    )
+    assert r.status_code == 200
+    body = r.json()
+    assert body["total_cents"] == 3 * 150 + 2 * 400
+    assert len(body["lines"]) == 2
+
+
+def test_get_order(client):
+    pen = make_item(client, "pen", 150)
+    oid = client.post(
+        "/orders",
+        json={
+            "customer_email": "a@example.com",
+            "lines": [{"item_id": pen, "quantity": 1}],
+        },
+    ).json()["id"]
+    r = client.get(f"/orders/{oid}")
+    assert r.status_code == 200
+    assert r.json()["total_cents"] == 150
+    assert r.json()["customer_email"] == "a@example.com"
+
+
+def test_get_missing_order(client):
+    assert client.get("/orders/999").status_code == 404
+
+
+def test_unknown_item(client):
+    r = client.post(
+        "/orders",
+        json={
+            "customer_email": "a@example.com",
+            "lines": [{"item_id": 42, "quantity": 1}],
+        },
+    )
+    assert r.status_code == 422
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        {"customer_email": "not-an-email", "lines": [{"item_id": 1, "quantity": 1}]},
+        {"customer_email": "a@example.com", "lines": []},
+        {"customer_email": "a@example.com", "lines": [{"item_id": 1, "quantity": 0}]},
+    ],
+)
+def test_invalid_payload(client, payload):
+    make_item(client, "pen", 150)
+    assert client.post("/orders", json=payload).status_code == 422
