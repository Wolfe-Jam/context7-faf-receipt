+import pytest
+from fastapi.testclient import TestClient
+from sqlmodel import Session, SQLModel, create_engine
+from sqlmodel.pool import StaticPool
+
+from app.db import get_session
+from app.main import app
+from app.models import Item
+
+
+@pytest.fixture(name="session")
+def session_fixture():
+    engine = create_engine(
+        "sqlite://", connect_args={"check_same_thread": False}, poolclass=StaticPool
+    )
+    SQLModel.metadata.create_all(engine)
+    with Session(engine) as session:
+        yield session
+
+
+@pytest.fixture(name="client")
+def client_fixture(session: Session):
+    app.dependency_overrides[get_session] = lambda: session
+    yield TestClient(app)
+    app.dependency_overrides.clear()
+
+
+@pytest.fixture(name="items")
+def items_fixture(session: Session):
+    pen = Item(name="pen", price_cents=150)
+    pad = Item(name="pad", price_cents=399)
+    session.add(pen)
+    session.add(pad)
+    session.commit()
+    return pen, pad
+
+
+def test_create_order_computes_total(client: TestClient, items):
+    pen, pad = items
+    r = client.post(
+        "/orders",
+        json={
+            "customer_email": "a@example.com",
+            "lines": [
+                {"item_id": pen.id, "quantity": 3},
+                {"item_id": pad.id, "quantity": 2},
+            ],
+        },
+    )
+    assert r.status_code == 200
+    data = r.json()
+    assert data["customer_email"] == "a@example.com"
+    assert data["total_cents"] == 3 * 150 + 2 * 399
+    assert len(data["lines"]) == 2
+
+
+def test_read_order(client: TestClient, items):
+    pen, _ = items
+    created = client.post(
+        "/orders",
+        json={"customer_email": "a@example.com", "lines": [{"item_id": pen.id, "quantity": 1}]},
+    ).json()
+    r = client.get(f"/orders/{created['id']}")
+    assert r.status_code == 200
+    assert r.json() == created
+
+
+def test_read_missing_order(client: TestClient):
+    assert client.get("/orders/999").status_code == 404
+
+
+def test_total_is_stable_after_reprice(client: TestClient, session: Session, items):
+    pen, _ = items
+    created = client.post(
+        "/orders",
+        json={"customer_email": "a@example.com", "lines": [{"item_id": pen.id, "quantity": 2}]},
+    ).json()
+    pen.price_cents = 999
+    session.add(pen)
+    session.commit()
+    assert client.get(f"/orders/{created['id']}").json()["total_cents"] == 300
+
+
+def test_unknown_item_rejected(client: TestClient, items):
+    r = client.post(
+        "/orders",
+        json={"customer_email": "a@example.com", "lines": [{"item_id": 12345, "quantity": 1}]},
+    )
+    assert r.status_code == 422
+
+
+@pytest.mark.parametrize(
+    "payload",
+    [
+        {"customer_email": "not-an-email", "lines": [{"item_id": 1, "quantity": 1}]},
+        {"customer_email": "a@example.com", "lines": []},
+        {"customer_email": "a@example.com", "lines": [{"item_id": 1, "quantity": 0}]},
+        {"customer_email": "a@example.com", "lines": [{"item_id": 1, "quantity": -2}]},
+        {"lines": [{"item_id": 1, "quantity": 1}]},
+    ],
+)
+def test_invalid_payloads(client: TestClient, items, payload):
+    assert client.post("/orders", json=payload).status_code == 422
