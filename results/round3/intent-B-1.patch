+@app.post("/orders", response_model=OrderRead)
+def create_order(order: OrderCreate, session: SessionDep) -> OrderRead:
+    item_ids = {l.item_id for l in order.lines}
+    items = {i.id: i for i in session.exec(select(Item).where(col(Item.id).in_(item_ids)))}
+    missing = sorted(item_ids - items.keys())
+    if missing:
+        raise HTTPException(status_code=422, detail=f"Unknown item ids: {missing}")
+
+    db_order = Order(
+        customer_email=order.customer_email,
+        lines=[
+            OrderLine(
+                item_id=l.item_id,
+                quantity=l.quantity,
+                unit_price_cents=items[l.item_id].price_cents,
+            )
+            for l in order.lines
+        ],
+    )
+    session.add(db_order)
+    session.commit()
+    session.refresh(db_order)
+    return to_order_read(db_order)
