+@app.post("/orders", response_model=OrderRead, status_code=201)
+def create_order(payload: OrderCreate, session: SessionDep) -> OrderRead:
+    # Merge duplicate item ids so each item appears once per order.
+    quantities: dict[int, int] = {}
+    for line in payload.lines:
+        quantities[line.item_id] = quantities.get(line.item_id, 0) + line.quantity
+
+    items = session.exec(select(Item).where(Item.id.in_(list(quantities)))).all()
+    prices = {i.id: i.price_cents for i in items}
+    missing = sorted(set(quantities) - set(prices))
+    if missing:
+        raise HTTPException(status_code=422, detail=f"Unknown item ids: {missing}")
+
+    order = Order(
+        customer_email=payload.customer_email,
+        total_cents=sum(prices[i] * q for i, q in quantities.items()),
+    )
+    session.add(order)
+    session.flush()
+    lines = [
+        OrderLine(order_id=order.id, item_id=i, quantity=q, unit_price_cents=prices[i])
+        for i, q in quantities.items()
+    ]
+    session.add_all(lines)
+    session.commit()
+    session.refresh(order)
+    return _order_read(order, lines)
+
+
+@app.get("/orders/{order_id}", response_model=OrderRead)
+def get_order(order_id: int, session: SessionDep) -> OrderRead:
+    order = session.get(Order, order_id)
+    if order is None:
+        raise HTTPException(status_code=404, detail="Order not found")
+    lines = session.exec(
+        select(OrderLine).where(OrderLine.order_id == order_id).order_by(OrderLine.id)
+    ).all()
+    return _order_read(order, list(lines))
