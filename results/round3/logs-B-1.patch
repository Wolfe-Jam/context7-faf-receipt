@@ -0,0 +1,27 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import express from 'express';
+import pino from 'pino';
+import pinoHttp from 'pino-http';
+import { errorHandler } from '../src/app.js';
+
+test('unhandled errors are logged and return 500 JSON', async () => {
+  const lines = [];
+  const logger = pino({ level: 'info' }, { write: (s) => lines.push(JSON.parse(s)) });
+  const app = express();
+  app.use(pinoHttp({ logger }));
+  app.get('/boom', async () => {
+    throw new Error('boom');
+  });
+  app.use(errorHandler);
+
+  const server = app.listen(0);
+  const { port } = server.address();
+  const r = await fetch(`http://127.0.0.1:${port}/boom`);
+  server.close();
+
+  assert.equal(r.status, 500);
+  assert.deepEqual(await r.json(), { error: 'Internal Server Error' });
+  const logged = lines.find((l) => l.msg === 'unhandled error');
+  assert.equal(logged.err.message, 'boom');
+});
