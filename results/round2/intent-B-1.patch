+from fastapi.testclient import TestClient
+
+from app.main import app
+
+
+def _item(client, name, price):
+    return client.post("/items", json={"name": name, "price_cents": price}).json()["id"]
+
+
+def _order(client, email, lines):
+    return client.post("/orders", json={"customer_email": email, "lines": lines})
+
+
+def test_create_and_read_order_total():
+    with TestClient(app) as client:
+        pen, pad = _item(client, "pen", 150), _item(client, "pad", 400)
+        r = _order(
+            client,
+            "a@example.com",
+            [{"item_id": pen, "quantity": 3}, {"item_id": pad, "quantity": 1}],
+        )
+        assert r.status_code == 201
+        body = r.json()
+        assert body["total_cents"] == 3 * 150 + 400
+        assert len(body["lines"]) == 2
+        got = client.get(f"/orders/{body['id']}")
+        assert got.status_code == 200
+        assert got.json() == body
+
+
+def test_order_unknown_item():
+    with TestClient(app) as client:
+        r = _order(client, "a@example.com", [{"item_id": 99999, "quantity": 1}])
+        assert r.status_code == 422
+
+
+def test_order_validation():
+    with TestClient(app) as client:
+        item = _item(client, "pen", 150)
+        ok_line = {"item_id": item, "quantity": 1}
+        assert _order(client, "a@example.com", []).status_code == 422
+        assert _order(client, "nope", [ok_line]).status_code == 422
+        assert _order(client, "a@example.com", [{"item_id": item, "quantity": 0}]).status_code == 422
+
+
+def test_order_not_found():
+    with TestClient(app) as client:
+        assert client.get("/orders/99999").status_code == 404
