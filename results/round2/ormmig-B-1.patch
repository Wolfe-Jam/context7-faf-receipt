@@ -0,0 +1,11 @@
+import { desc, eq } from 'drizzle-orm';
+import { db } from './db';
+import { comments } from './db/schema';
+
+export function listCommentsForPost(postId: number) {
+  return db
+    .select()
+    .from(comments)
+    .where(eq(comments.postId, postId))
+    .orderBy(desc(comments.createdAt), desc(comments.id));
+}
