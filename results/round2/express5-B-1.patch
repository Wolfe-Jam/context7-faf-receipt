+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtemp, mkdir, writeFile, rm } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import path from 'node:path';
+import { createApp } from '../src/app.js';
+
+let dir, server, base;
+
+before(async () => {
+  dir = await mkdtemp(path.join(tmpdir(), 'files-api-'));
+  await mkdir(path.join(dir, 'root', 'docs', 'guide'), { recursive: true });
+  await writeFile(path.join(dir, 'root', 'docs', 'guide', 'intro.md'), 'hello');
+  await writeFile(path.join(dir, 'secret.txt'), 'nope');
+  server = createApp({ root: path.join(dir, 'root') }).listen(0);
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+
+after(async () => {
+  server.close();
+  await rm(dir, { recursive: true, force: true });
+});
+
+test('returns metadata for nested file path', async () => {
+  const r = await fetch(`${base}/files/docs/guide/intro.md`);
+  assert.equal(r.status, 200);
+  const body = await r.json();
+  assert.equal(body.path, 'docs/guide/intro.md');
+  assert.equal(body.name, 'intro.md');
+  assert.equal(body.type, 'file');
+  assert.equal(body.size, 5);
+  assert.ok(!Number.isNaN(Date.parse(body.modified)));
+});
+
+test('returns metadata for a directory', async () => {
+  const r = await fetch(`${base}/files/docs`);
+  assert.equal(r.status, 200);
+  assert.equal((await r.json()).type, 'directory');
+});
+
+test('missing file gives JSON 404', async () => {
+  const r = await fetch(`${base}/files/docs/nope.md`);
+  assert.equal(r.status, 404);
+  assert.match(r.headers.get('content-type'), /json/);
+  assert.deepEqual(await r.json(), { error: 'File not found' });
+});
+
+test('path traversal cannot escape root', async () => {
+  const r = await fetch(`${base}/files/%2e%2e/secret.txt`);
+  assert.notEqual(r.status, 200);
+  assert.match(r.headers.get('content-type'), /json/);
+});
+
+test('unknown route gives JSON 404', async () => {
+  const r = await fetch(`${base}/nope`);
+  assert.equal(r.status, 404);
+  assert.match(r.headers.get('content-type'), /json/);
+  assert.deepEqual(await r.json(), { error: 'Not found' });
+});
+
+test('unsupported method on known route gives JSON 404', async () => {
+  const r = await fetch(`${base}/health`, { method: 'POST' });
+  assert.equal(r.status, 404);
+  assert.match(r.headers.get('content-type'), /json/);
+});
