+from fastapi import FastAPI, HTTPException
 from pydantic import BaseModel
 
 app = FastAPI()
@@ -10,9 +10,37 @@
     email: str
 
 
+class CustomerCreate(BaseModel):
+    name: str
+    email: str
+
+
+class EmailUpdate(BaseModel):
+    email: str
+
+
 CUSTOMERS = {1: Customer(id=1, name="Ada", email="ada@example.com")}
 
 
 @app.get("/customers/{customer_id}", response_model=Customer)
 def get_customer(customer_id: int) -> Customer:
+    if customer_id not in CUSTOMERS:
+        raise HTTPException(status_code=404, detail="Customer not found")
     return CUSTOMERS[customer_id]
+
+
+@app.post("/customers", response_model=Customer, status_code=201)
+def create_customer(body: CustomerCreate) -> Customer:
+    new_id = max(CUSTOMERS, default=0) + 1
+    customer = Customer(id=new_id, **body.dict())
+    CUSTOMERS[new_id] = customer
+    return customer
+
+
+@app.patch("/customers/{customer_id}/email", response_model=Customer)
+def update_customer_email(customer_id: int, body: EmailUpdate) -> Customer:
+    if customer_id not in CUSTOMERS:
+        raise HTTPException(status_code=404, detail="Customer not found")
+    customer = CUSTOMERS[customer_id].copy(update={"email": body.email})
+    CUSTOMERS[customer_id] = customer
+    return customer
