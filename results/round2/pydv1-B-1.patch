+@app.post("/customers", response_model=Customer, status_code=201)
+def create_customer(body: CustomerCreate) -> Customer:
+    customer_id = max(CUSTOMERS, default=0) + 1
+    customer = Customer(id=customer_id, **body.dict())
+    CUSTOMERS[customer_id] = customer
+    return customer
+
+
+@app.patch("/customers/{customer_id}/email", response_model=Customer)
+def update_customer_email(customer_id: int, body: EmailUpdate) -> Customer:
+    if customer_id not in CUSTOMERS:
+        raise HTTPException(status_code=404, detail="Customer not found")
+    customer = CUSTOMERS[customer_id].copy(update={"email": body.email})
+    CUSTOMERS[customer_id] = customer
+    return customer
