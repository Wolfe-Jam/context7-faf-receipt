@@ -5,3 +5,15 @@
 export function listBookmarks() {
   return sql<Bookmark[]>`select id, url, title, created_at from bookmarks order by created_at desc`;
 }
+
+export type TagCount = { name: string; count: number };
+
+// count(*) is bigint, which postgres.js returns as a string; cast to int.
+export function listTags() {
+  return sql<TagCount[]>`
+    select t.name, count(bt.bookmark_id)::int as count
+    from tags t
+    left join bookmark_tags bt on bt.tag_id = t.id
+    group by t.id, t.name
+    order by count desc, t.name`;
+}
