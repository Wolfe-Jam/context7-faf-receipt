+import { test, before, after } from 'node:test';
+import assert from 'node:assert/strict';
+import { app } from '../src/app.js';
+
+let server, base;
+before(() => {
+  server = app.listen(0);
+  base = `http://127.0.0.1:${server.address().port}`;
+});
+after(() => server.close());
+
+test('single-segment file', async () => {
+  const r = await fetch(`${base}/files/readme.md`);
+  assert.equal(r.status, 200);
+  assert.deepEqual(await r.json(), {
+    path: 'readme.md', name: 'readme.md', directory: '', extension: 'md', segments: ['readme.md'],
+  });
+});
+
+test('nested path with slashes', async () => {
+  const r = await fetch(`${base}/files/a/b/c/archive.tar.gz`);
+  assert.equal(r.status, 200);
+  const body = await r.json();
+  assert.equal(body.path, 'a/b/c/archive.tar.gz');
+  assert.equal(body.directory, 'a/b/c');
+  assert.equal(body.extension, 'gz');
+  assert.deepEqual(body.segments, ['a', 'b', 'c', 'archive.tar.gz']);
+});
+
+test('dotfile has no extension', async () => {
+  const body = await (await fetch(`${base}/files/dir/.gitignore`)).json();
+  assert.equal(body.extension, '');
+});
+
+test('/files/ with no path is a JSON 404', async () => {
+  const r = await fetch(`${base}/files/`);
+  assert.equal(r.status, 404);
+  assert.match(r.headers.get('content-type'), /application\/json/);
+});
+
+test('unknown route returns JSON 404', async () => {
+  const r = await fetch(`${base}/nope/x`);
+  assert.equal(r.status, 404);
+  assert.match(r.headers.get('content-type'), /application\/json/);
+  assert.deepEqual(await r.json(), { error: 'Not Found', path: '/nope/x' });
+});
+
+test('unsupported method on known route is JSON 404', async () => {
+  const r = await fetch(`${base}/health`, { method: 'POST' });
+  assert.equal(r.status, 404);
+  assert.equal((await r.json()).error, 'Not Found');
+});
