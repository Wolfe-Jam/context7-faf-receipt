+
+@app.command()
+def status(
+    urls: list[str] = typer.Argument(..., help="URLs to check."),
+    timeout: float = typer.Option(10.0, help="Per-request timeout in seconds."),
+    follow_redirects: bool = typer.Option(
+        False, "--follow-redirects", help="Follow redirects and report the final status."
+    ),
+) -> None:
+    """Print the HTTP status code for each URL."""
+    failed = False
+    with httpx.Client(timeout=timeout, follow_redirects=follow_redirects) as client:
+        for url in urls:
+            try:
+                print(f"{client.get(url).status_code} {url}")
+            except httpx.HTTPError as exc:
+                failed = True
+                print(f"ERR {url} ({type(exc).__name__}: {exc})")
+    if failed:
+        raise typer.Exit(code=1)
 
 
