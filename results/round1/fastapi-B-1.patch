+@pytest.fixture
+def client() -> Iterator[TestClient]:
+    engine = create_engine(
+        "sqlite://",
+        connect_args={"check_same_thread": False},
+        poolclass=StaticPool,
+    )
+    SQLModel.metadata.create_all(engine)
+
+    def override_session() -> Iterator[Session]:
+        with Session(engine) as session:
+            yield session
+
+    app.dependency_overrides[get_session] = override_session
+    with TestClient(app) as c:
+        yield c
+    app.dependency_overrides.clear()
+
+
+def test_create_item(client: TestClient):
+    r = client.post("/items", json={"name": "pen", "price_cents": 150})
+    assert r.status_code == 200
+    assert r.json()["name"] == "pen"
+
+
+def test_list_items_pagination(client: TestClient):
+    for i in range(5):
+        client.post("/items", json={"name": f"item{i}", "price_cents": i})
+
+    r = client.get("/items")
+    assert r.status_code == 200
+    assert [x["name"] for x in r.json()] == [f"item{i}" for i in range(5)]
+
+    r = client.get("/items", params={"offset": 1, "limit": 2})
+    assert [x["name"] for x in r.json()] == ["item1", "item2"]
+
+    r = client.get("/items", params={"offset": 10})
+    assert r.json() == []
+
+
+def test_list_items_limit_validation(client: TestClient):
+    assert client.get("/items", params={"limit": 100}).status_code == 200
+    assert client.get("/items", params={"limit": 101}).status_code == 422
+    assert client.get("/items", params={"limit": 0}).status_code == 422
+    assert client.get("/items", params={"offset": -1}).status_code == 422
