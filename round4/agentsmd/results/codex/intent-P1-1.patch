+from fastapi.testclient import TestClient
+
+from app.main import app
+
+
+def test_create_order_uses_item_prices_for_line_and_order_totals():
+    with TestClient(app) as client:
+        pen = client.post("/items", json={"name": "order pen", "price_cents": 150}).json()
+        notebook = client.post("/items", json={"name": "order notebook", "price_cents": 425}).json()
+
+        response = client.post(
+            "/orders",
+            json={
+                "customer_email": "shopper@example.com",
+                "line_items": [
+                    {"item_id": pen["id"], "quantity": 2},
+                    {"item_id": notebook["id"], "quantity": 1},
+                ],
+            },
+        )
+
+    assert response.status_code == 200
+    assert response.json() == {
+        "id": response.json()["id"],
+        "customer_email": "shopper@example.com",
+        "line_items": [
+            {"item_id": pen["id"], "quantity": 2, "unit_price_cents": 150, "subtotal_cents": 300},
+            {"item_id": notebook["id"], "quantity": 1, "unit_price_cents": 425, "subtotal_cents": 425},
+        ],
+        "total_cents": 725,
+    }
+
+
+def test_create_order_rejects_unknown_item():
+    with TestClient(app) as client:
+        response = client.post(
+            "/orders",
+            json={"customer_email": "shopper@example.com", "line_items": [{"item_id": 999999, "quantity": 1}]},
+        )
+
+    assert response.status_code == 404
+
+
+def test_create_order_requires_positive_quantity():
+    with TestClient(app) as client:
+        response = client.post(
+            "/orders",
+            json={"customer_email": "shopper@example.com", "line_items": [{"item_id": 1, "quantity": 0}]},
+        )
+
+    assert response.status_code == 422
