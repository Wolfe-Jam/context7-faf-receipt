+@app.post("/orders", response_model=OrderRead)
+def create_order(order: OrderCreate, session: SessionDep) -> OrderRead:
+    items_by_id = {}
+    for requested_line in order.line_items:
+        item = session.get(Item, requested_line.item_id)
+        if item is None:
+            raise HTTPException(status_code=404, detail=f"Item {requested_line.item_id} not found")
+        items_by_id[requested_line.item_id] = item
+
+    lines = [
+        OrderLine(
+            item_id=line.item_id,
+            quantity=line.quantity,
+            unit_price_cents=items_by_id[line.item_id].price_cents,
+        )
+        for line in order.line_items
+    ]
+    total_cents = sum(line.quantity * items_by_id[line.item_id].price_cents for line in order.line_items)
+    db_order = Order(customer_email=order.customer_email, total_cents=total_cents)
+    session.add(db_order)
+    session.flush()
+    for line in lines:
+        line.order_id = db_order.id
+        session.add(line)
+    session.commit()
+    session.refresh(db_order)
+    return OrderRead(
+        id=db_order.id,
+        customer_email=db_order.customer_email,
+        line_items=[
+            {
+                "item_id": line.item_id,
+                "quantity": line.quantity,
+                "unit_price_cents": line.unit_price_cents,
+                "subtotal_cents": line.quantity * line.unit_price_cents,
+            }
+            for line in lines
+        ],
+        total_cents=db_order.total_cents,
+    )
