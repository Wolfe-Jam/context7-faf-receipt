+def test_create_and_get_order_uses_item_prices():
+    with TestClient(app) as client:
+        pen = client.post("/items", json={"name": "pen", "price_cents": 150}).json()
+        notebook = client.post("/items", json={"name": "notebook", "price_cents": 425}).json()
+
+        response = client.post(
+            "/orders",
+            json={
+                "customer_email": "buyer@example.com",
+                "line_items": [
+                    {"item_id": pen["id"], "quantity": 2},
+                    {"item_id": notebook["id"], "quantity": 1},
+                ],
+            },
+        )
+
+        assert response.status_code == 201
+        order = response.json()
+        assert order["customer_email"] == "buyer@example.com"
+        assert order["total_cents"] == 725
+        assert [line["subtotal_cents"] for line in order["line_items"]] == [300, 425]
+        # Order prices are snapshots; later item price changes do not alter an order.
+        client.post("/items", json={"name": "replacement", "price_cents": 999})
+        assert client.get(f"/orders/{order['id']}").json() == order
+
+
+def test_create_order_rejects_missing_items_and_invalid_lines():
+    with TestClient(app) as client:
+        missing = client.post(
+            "/orders",
+            json={"customer_email": "buyer@example.com", "line_items": [{"item_id": 999999, "quantity": 1}]},
+        )
+        assert missing.status_code == 404
+
+        invalid = client.post(
+            "/orders",
+            json={"customer_email": "not-an-email", "line_items": [{"item_id": 1, "quantity": 0}]},
