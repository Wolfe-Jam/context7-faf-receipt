+@app.post("/orders", response_model=OrderRead, status_code=201)
+def create_order(order: OrderCreate, session: SessionDep) -> OrderRead:
+    items: list[Item] = []
+    for requested_line in order.line_items:
+        item = session.get(Item, requested_line.item_id)
+        if item is None:
+            raise HTTPException(status_code=404, detail=f"Item {requested_line.item_id} not found")
+        items.append(item)
+
+    db_order = Order(customer_email=order.customer_email)
+    session.add(db_order)
+    session.flush()
+    lines = [
+        OrderLine(
+            order_id=db_order.id,
+            item_id=item.id,
+            quantity=requested_line.quantity,
+            unit_price_cents=item.price_cents,
+        )
+        for requested_line, item in zip(order.line_items, items)
+    ]
+    session.add_all(lines)
+    session.commit()
+    session.refresh(db_order)
+    return _order_read(db_order, lines)
+
