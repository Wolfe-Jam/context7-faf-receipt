+def test_create_order_uses_item_prices_and_persists_line_details():
+    with TestClient(app) as client:
+        first = client.post("/items", json={"name": "pen", "price_cents": 150})
+        second = client.post("/items", json={"name": "notebook", "price_cents": 425})
+
+        response = client.post(
+            "/orders",
+            json={
+                "customer_email": "shopper@example.com",
+                "line_items": [
+                    {"item_id": first.json()["id"], "quantity": 3},
+                    {"item_id": second.json()["id"], "quantity": 2},
+                ],
+            },
+        )
+
+        assert response.status_code == 201
+        assert response.json() == {
+            "id": response.json()["id"],
+            "customer_email": "shopper@example.com",
+            "line_items": [
+                {"item_id": first.json()["id"], "quantity": 3, "unit_price_cents": 150},
+                {"item_id": second.json()["id"], "quantity": 2, "unit_price_cents": 425},
+            ],
+            "total_cents": 1300,
+        }
+
+
+def test_create_order_rejects_unknown_item_without_creating_order():
+    with TestClient(app) as client:
+        response = client.post(
+            "/orders",
+            json={
+                "customer_email": "shopper@example.com",
+                "line_items": [{"item_id": 999999, "quantity": 1}],
+            },
+        )
+
+        assert response.status_code == 404
+        assert response.json()["detail"] == "Item 999999 not found"
+
+
+def test_create_order_requires_at_least_one_line_and_positive_quantities():
+    with TestClient(app) as client:
+        empty = client.post(
+            "/orders",
+            json={"customer_email": "shopper@example.com", "line_items": []},
+        )
+        zero_quantity = client.post(
+            "/orders",
+            json={
+                "customer_email": "shopper@example.com",
+                "line_items": [{"item_id": 1, "quantity": 0}],
+            },
+        )
+
+        assert empty.status_code == 422
+        assert zero_quantity.status_code == 422
