+@app.post("/orders", response_model=OrderRead, status_code=201)
+def create_order(order: OrderCreate, session: SessionDep) -> OrderRead:
+    lines: list[OrderLine] = []
+    total_cents = 0
+    for requested_line in order.line_items:
+        item = session.get(Item, requested_line.item_id)
+        if item is None:
+            raise HTTPException(
+                status_code=404,
+                detail=f"Item {requested_line.item_id} not found",
+            )
+        line_total = item.price_cents * requested_line.quantity
+        total_cents += line_total
+        lines.append(
+            OrderLine(
+                item_id=item.id,
+                quantity=requested_line.quantity,
+                unit_price_cents=item.price_cents,
+            )
+        )
+
+    db_order = Order(customer_email=order.customer_email, total_cents=total_cents)
+    session.add(db_order)
+    session.flush()
+    for line in lines:
+        line.order_id = db_order.id
+        session.add(line)
+    session.commit()
+    session.refresh(db_order)
+    return OrderRead(
+        id=db_order.id,
+        customer_email=db_order.customer_email,
+        total_cents=db_order.total_cents,
+        line_items=[
+            {
+                "item_id": line.item_id,
+                "quantity": line.quantity,
+                "unit_price_cents": line.unit_price_cents,
+            }
+            for line in lines
+        ],
+    )
