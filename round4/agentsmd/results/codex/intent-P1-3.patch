+def test_create_order_uses_item_prices():
+    with TestClient(app) as client:
+        item = client.post("/items", json={"name": "notebook", "price_cents": 275}).json()
+        r = client.post(
+            "/orders",
+            json={
+                "customer_email": "buyer@example.com",
+                "line_items": [{"item_id": item["id"], "quantity": 3}],
+            },
+        )
+        assert r.status_code == 200
+        assert r.json()["total_cents"] == 825
+        assert r.json()["line_items"] == [
+            {"item_id": item["id"], "quantity": 3, "unit_price_cents": 275}
+        ]
+
+
+def test_create_order_rejects_missing_items_and_nonpositive_quantity():
+    with TestClient(app) as client:
+        missing = client.post(
+            "/orders",
+            json={"customer_email": "buyer@example.com", "line_items": [{"item_id": 999999, "quantity": 1}]},
+        )
+        assert missing.status_code == 404
+
+        invalid_quantity = client.post(
