+def test_create_order_uses_item_prices():
+    with TestClient(app) as client:
+        item = client.post("/items", json={"name": "notebook", "price_cents": 325}).json()
+        response = client.post(
+            "/orders",
+            json={"customer_email": "buyer@example.com", "lines": [{"item_id": item["id"], "quantity": 3}]},
+        )
+
+        assert response.status_code == 200
+        assert response.json()["total_cents"] == 975
+        assert response.json()["lines"] == [
+            {"item_id": item["id"], "quantity": 3, "unit_price_cents": 325}
+        ]
+
+
+def test_create_order_rejects_missing_items_and_nonpositive_quantity():
+    with TestClient(app) as client:
+        missing_item = client.post(
+            "/orders",
+            json={"customer_email": "buyer@example.com", "lines": [{"item_id": 99999, "quantity": 1}]},
+        )
+        invalid_quantity = client.post(
+            "/orders",
+            json={"customer_email": "buyer@example.com", "lines": [{"item_id": 1, "quantity": 0}]},
