+@app.post("/orders", response_model=OrderRead)
+def create_order(order: OrderCreate, session: SessionDep) -> Order:
+    item_ids = {line.item_id for line in order.lines}
+    items = session.query(Item).filter(Item.id.in_(item_ids)).all()
+    items_by_id = {item.id: item for item in items}
+    if item_ids - items_by_id.keys():
+        raise HTTPException(status_code=404, detail="One or more items were not found")
+
+    lines = [
+        OrderLine(
+            item_id=line.item_id,
+            quantity=line.quantity,
+            unit_price_cents=items_by_id[line.item_id].price_cents,
+        )
+        for line in order.lines
+    ]
+    db_order = Order(
+        customer_email=order.customer_email,
+        total_cents=sum(line.unit_price_cents * line.quantity for line in lines),
+        lines=lines,
+    )
+    session.add(db_order)
+    session.commit()
+    session.refresh(db_order)
+    return db_order
