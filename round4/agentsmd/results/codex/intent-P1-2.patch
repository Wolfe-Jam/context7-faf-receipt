+def test_create_order_calculates_total_from_item_prices():
+    with TestClient(app) as client:
+        pen = client.post("/items", json={"name": "order pen", "price_cents": 150}).json()
+        notebook = client.post(
+            "/items", json={"name": "order notebook", "price_cents": 425}
+        ).json()
+
+        response = client.post(
+            "/orders",
+            json={
+                "customer_email": "buyer@example.com",
+                "items": [
+                    {"item_id": pen["id"], "quantity": 2},
+                    {"item_id": notebook["id"], "quantity": 1},
+                ],
+            },
+        )
+
+        assert response.status_code == 200
+        order = response.json()
+        assert order["total_cents"] == 725
+        assert order["customer_email"] == "buyer@example.com"
+        assert [line["quantity"] for line in order["items"]] == [2, 1]
+
+        persisted = client.get(f"/orders/{order['id']}")
+        assert persisted.status_code == 200
+        assert persisted.json() == order
+
+
+def test_create_order_rejects_missing_items_and_nonpositive_quantities():
+    with TestClient(app) as client:
+        missing_item = client.post(
+            "/orders",
+            json={
+                "customer_email": "buyer@example.com",
+                "items": [{"item_id": 999999, "quantity": 1}],
+            },
+        )
+        invalid_quantity = client.post(
+            "/orders",
+            json={
+                "customer_email": "buyer@example.com",
+                "items": [{"item_id": 1, "quantity": 0}],
+            },
+        )
+
+        assert missing_item.status_code == 404
+        assert invalid_quantity.status_code == 422
