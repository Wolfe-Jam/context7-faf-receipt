+@app.post("/orders", response_model=OrderRead)
+def create_order(order: OrderCreate, session: SessionDep) -> OrderRead:
+    priced_lines: list[tuple[int, int, int]] = []
+    total_cents = 0
+    for line in order.items:
+        item = session.get(Item, line.item_id)
+        if item is None:
+            raise HTTPException(status_code=404, detail=f"Item {line.item_id} not found")
+        line_total = item.price_cents * line.quantity
+        total_cents += line_total
+        priced_lines.append((item.id, line.quantity, item.price_cents))
+
+    db_order = Order(customer_email=order.customer_email, total_cents=total_cents)
+    session.add(db_order)
+    session.flush()
+    lines = [
+        OrderLine(
+            order_id=db_order.id,
+            item_id=item_id,
+            quantity=quantity,
+            unit_price_cents=unit_price_cents,
+        )
+        for item_id, quantity, unit_price_cents in priced_lines
+    ]
+    session.add_all(lines)
+    session.commit()
+    session.refresh(db_order)
+    return OrderRead(
+        id=db_order.id,
+        customer_email=db_order.customer_email,
+        total_cents=db_order.total_cents,
+        items=[
+            OrderLineRead(
+                item_id=line.item_id,
+                quantity=line.quantity,
+                unit_price_cents=line.unit_price_cents,
+            )
+            for line in lines
+        ],
+    )
