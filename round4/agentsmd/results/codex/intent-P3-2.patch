+from fastapi.testclient import TestClient
+
+from app.main import app
+
+
+def test_create_order_uses_item_prices_for_total():
+    with TestClient(app) as client:
+        pen = client.post("/items", json={"name": "pen", "price_cents": 150}).json()
+        notebook = client.post("/items", json={"name": "notebook", "price_cents": 425}).json()
+
+        response = client.post(
+            "/orders",
+            json={
+                "customer_email": "buyer@example.com",
+                "lines": [
+                    {"item_id": pen["id"], "quantity": 2},
+                    {"item_id": notebook["id"], "quantity": 1},
+                ],
+            },
+        )
+
+        assert response.status_code == 200
+        order = response.json()
+        assert order["customer_email"] == "buyer@example.com"
+        assert order["total_cents"] == 725
+        assert order["lines"] == [
+            {"item_id": pen["id"], "quantity": 2, "unit_price_cents": 150},
+            {"item_id": notebook["id"], "quantity": 1, "unit_price_cents": 425},
+        ]
+
+
+def test_create_order_rejects_unknown_item():
+    with TestClient(app) as client:
+        response = client.post(
+            "/orders",
+            json={"customer_email": "buyer@example.com", "lines": [{"item_id": 999999, "quantity": 1}]},
+        )
+
+        assert response.status_code == 404
+
+
+def test_create_order_requires_positive_quantity():
+    with TestClient(app) as client:
+        item = client.post("/items", json={"name": "pen", "price_cents": 150}).json()
+        response = client.post(
+            "/orders",
+            json={"customer_email": "buyer@example.com", "lines": [{"item_id": item["id"], "quantity": 0}]},
+        )
+
+        assert response.status_code == 422
