+@app.post("/orders", response_model=OrderRead)
+def create_order(order: OrderCreate, session: SessionDep) -> Order:
+    items: dict[int, Item] = {}
+    for line in order.lines:
+        item = session.get(Item, line.item_id)
+        if item is None:
+            raise HTTPException(status_code=404, detail=f"Item {line.item_id} not found")
+        items[line.item_id] = item
+
+    db_order = Order(customer_email=order.customer_email, total_cents=0)
+    db_order.lines = [
+        OrderLine(
+            item_id=line.item_id,
+            quantity=line.quantity,
+            unit_price_cents=items[line.item_id].price_cents,
+        )
+        for line in order.lines
+    ]
+    db_order.total_cents = sum(line.quantity * items[line.item_id].price_cents for line in order.lines)
+    session.add(db_order)
+    session.commit()
+    session.refresh(db_order)
+    return db_order
