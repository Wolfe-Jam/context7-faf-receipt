+def test_create_order_total_uses_item_prices():
+    with TestClient(app) as client:
+        item = client.post("/items", json={"name": "notebook", "price_cents": 275}).json()
+        response = client.post("/orders", json={
+            "customer_email": "buyer@example.com",
+            "line_items": [{"item_id": item["id"], "quantity": 3}],
+        })
+
+    assert response.status_code == 200
+    assert response.json() == {
+        "id": response.json()["id"],
+        "customer_email": "buyer@example.com",
+        "line_items": [{
+            "item_id": item["id"],
+            "quantity": 3,
+            "unit_price_cents": 275,
+        }],
+        "total_cents": 825,
