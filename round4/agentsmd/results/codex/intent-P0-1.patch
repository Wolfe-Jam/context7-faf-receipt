 from fastapi.testclient import TestClient
+import pytest
+from sqlmodel import Session, SQLModel, create_engine
 
+from app.db import get_session
 from app.main import app
 
 
+@pytest.fixture
+def client(tmp_path):
+    engine = create_engine(f"sqlite:///{tmp_path / 'test.db'}")
+    SQLModel.metadata.create_all(engine)
+
+    def get_test_session():
+        with Session(engine) as session:
+            yield session
+
+    app.dependency_overrides[get_session] = get_test_session
+    with TestClient(app) as test_client:
+        yield test_client
+    app.dependency_overrides.clear()
+
+
 def test_create_item():
     with TestClient(app) as client:
         r = client.post("/items", json={"name": "pen", "price_cents": 150})
         assert r.status_code == 200
         assert r.json()["name"] == "pen"
+
+
+def test_create_order_calculates_total_from_item_prices(client):
+    pen = client.post("/items", json={"name": "pen", "price_cents": 150}).json()
+    book = client.post("/items", json={"name": "book", "price_cents": 500}).json()
+
+    response = client.post(
+        "/orders",
+        json={
+            "customer_email": "buyer@example.com",
+            "line_items": [
+                {"item_id": pen["id"], "quantity": 3},
+                {"item_id": book["id"], "quantity": 2},
+            ],
+        },
+    )
+
+    assert response.status_code == 200
+    assert response.json() == {
+        "id": 1,
+        "customer_email": "buyer@example.com",
+        "total_cents": 1450,
+        "line_items": [
+            {"item_id": pen["id"], "quantity": 3, "unit_price_cents": 150, "line_total_cents": 450},
+            {"item_id": book["id"], "quantity": 2, "unit_price_cents": 500, "line_total_cents": 1000},
+        ],
+    }
+
+
+def test_create_order_rejects_unknown_item(client):
+    response = client.post(
+        "/orders",
+        json={"customer_email": "buyer@example.com", "line_items": [{"item_id": 999, "quantity": 1}]},
+    )
+
+    assert response.status_code == 404
+    assert response.json()["detail"] == "Item 999 not found"
+
+
+def test_create_order_requires_positive_quantity(client):
+    response = client.post(
+        "/orders",
+        json={"customer_email": "buyer@example.com", "line_items": [{"item_id": 1, "quantity": 0}]},
+    )
+
+    assert response.status_code == 422
