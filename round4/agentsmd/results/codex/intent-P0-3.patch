+def test_create_order_uses_item_prices():
+    with TestClient(app) as client:
+        item_response = client.post("/items", json={"name": "pen", "price_cents": 150})
+        item_id = item_response.json()["id"]
+
+        response = client.post(
+            "/orders",
+            json={
+                "customer_email": "buyer@example.com",
+                "lines": [{"item_id": item_id, "quantity": 3}],
+            },
+        )
+
+        assert response.status_code == 200
+        assert response.json()["customer_email"] == "buyer@example.com"
+        assert response.json()["lines"] == [
+            {"item_id": item_id, "quantity": 3, "unit_price_cents": 150}
+        ]
+        assert response.json()["total_cents"] == 450
+
+
